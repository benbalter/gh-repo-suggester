#!/usr/bin/env bash
# gh-repo-suggester — recommend repos to watch in a GitHub org
set -euo pipefail

VERSION="1.0.0"

usage() {
  cat <<EOF
Recommend repos to watch in a GitHub org, powered by GitHub Models.

USAGE
  gh repo-suggester <org> [flags]

FLAGS
  -n, --count <N>       Number of recommendations (default: 5)
  -m, --model <ID>      GitHub Models model ID (default: openai/gpt-4o-mini)
  -t, --topic <TOPIC>   Filter candidate repos by topic
  -h, --help            Show this help
  --version             Show version

EXAMPLES
  gh repo-suggester github
  gh repo-suggester my-org --count 10
  gh repo-suggester my-org --topic api --model openai/gpt-4o
EOF
}

# ── Parse arguments ──────────────────────────────────────────────────

COUNT=5
MODEL="openai/gpt-4o-mini"
TOPIC=""
ORG=""

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--count)   COUNT="$2"; shift 2 ;;
    -m|--model)   MODEL="$2"; shift 2 ;;
    -t|--topic)   TOPIC="$2"; shift 2 ;;
    -h|--help)    usage; exit 0 ;;
    --version)    echo "gh-repo-suggester $VERSION"; exit 0 ;;
    -*)           echo "Unknown flag: $1" >&2; usage >&2; exit 1 ;;
    *)            ORG="$1"; shift ;;
  esac
done

if [ -z "$ORG" ]; then
  echo "Error: org argument is required" >&2
  echo "" >&2
  usage >&2
  exit 1
fi

if ! command -v jq &>/dev/null; then
  echo "Error: jq is required. Install it: https://jqlang.github.io/jq/download/" >&2
  exit 1
fi

# ── Fetch data via gh api (uses existing auth — no PAT needed) ───────

TOKEN=$(gh auth token)
TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

JQ_WATCHED='
  [.[] | {
    name:        .full_name,
    description: (.description // ""),
    language:    (.language // "unknown"),
    topics:      ((.topics // []) | join(", "))
  }]'

JQ_ORG='
  [.[] | select(.archived != true) | {
    name:            .full_name,
    description:     (.description // ""),
    language:        (.language // "unknown"),
    topics:          ((.topics // []) | join(", ")),
    stars:           .stargazers_count,
    has_discussions:  (.has_discussions // false),
    has_issues:       (.has_issues // false)
  }]'

# Fetch watched repos and org repos in parallel (both fully paginated)
echo "Fetching watched repos and repos in $ORG..." >&2

gh api /user/subscriptions --paginate --jq "$JQ_WATCHED" \
  | jq -s 'add // [] | .[0:100]' > "$TMPDIR/watched.json" 2>"$TMPDIR/watched-err.txt" &
PID_W=$!

gh api "/orgs/${ORG}/repos?per_page=100&sort=updated&direction=desc" --paginate --jq "$JQ_ORG" \
  | jq -s 'add // []' > "$TMPDIR/org.json" 2>"$TMPDIR/org-err.txt" &
PID_O=$!

FETCH_FAILED=false
wait "$PID_W" || FETCH_FAILED=true
wait "$PID_O" || FETCH_FAILED=true

if $FETCH_FAILED; then
  echo "Error fetching repos:" >&2
  cat "$TMPDIR/watched-err.txt" "$TMPDIR/org-err.txt" >&2
  exit 1
fi

WATCHED=$(cat "$TMPDIR/watched.json")
ORG_REPOS=$(cat "$TMPDIR/org.json")

WATCHED_COUNT=$(echo "$WATCHED" | jq 'length')
ORG_COUNT=$(echo "$ORG_REPOS" | jq 'length')
echo "  $WATCHED_COUNT watched repos, $ORG_COUNT repos in $ORG" >&2

# ── Filter ───────────────────────────────────────────────────────────

if [ -n "$TOPIC" ]; then
  ORG_REPOS=$(echo "$ORG_REPOS" | jq --arg t "$TOPIC" '
    [.[] | select(.topics | ascii_downcase | contains($t | ascii_downcase))]
  ')
  echo "  Filtered to $(echo "$ORG_REPOS" | jq 'length') repos matching topic \"$TOPIC\"" >&2
fi

WATCHED_NAMES=$(echo "$WATCHED" | jq '[.[].name]')
CANDIDATES=$(echo "$ORG_REPOS" | jq --argjson w "$WATCHED_NAMES" '
  [.[] | select(.name as $n | ($w | index($n)) | not)] | .[0:200]
')

CANDIDATE_COUNT=$(echo "$CANDIDATES" | jq 'length')
if [ "$CANDIDATE_COUNT" -eq 0 ]; then
  echo "" >&2
  echo "No unwatched repos found in $ORG — you're already watching them all! 👀"
  exit 0
fi

echo "Asking $MODEL to pick $COUNT from $CANDIDATE_COUNT candidates..." >&2

# ── Build prompt ─────────────────────────────────────────────────────

CANDIDATE_LIST=$(echo "$CANDIDATES" | jq -r '
  .[] | "- \(.name) (\(.language), \(.stars)★): \(.description) [topics: \(.topics), discussions: \(.has_discussions), issues: \(.has_issues)]"
')

read -r -d '' SYSTEM_PROMPT <<'SYSTEM_EOF' || true
You are an expert at recommending GitHub repositories. You analyze a user's
watched repos to infer their interests, then match those interests against
candidate repos in a specific organization.

## Your process

1. Identify 3-5 interest themes from the user's watched repos (e.g. languages,
   domains, tooling patterns). If the user has no watched repos, recommend the
   most broadly useful and popular repos from the candidates.
2. Score each candidate repo against those themes.
3. Select the top candidates, preferring diversity across themes over clustering
   on a single theme.
4. For each pick, choose the most appropriate GitHub watching type:

   - "All Activity" — the repo is central to the user's day-to-day work
   - "Issues and Pull Requests" — the user would likely contribute or follow
     development closely
   - "Releases Only" — the repo is a library, CLI tool, or dependency where
     only new versions matter
   - "Discussions" — the repo has discussions enabled AND aligns with the
     user's community interests
   - "Security Alerts" — the repo is an infrastructure or security-sensitive
     dependency

   Use the candidate metadata (has_discussions, has_issues, stars, language) to
   inform the watch type. Do NOT suggest "Discussions" if discussions are false.

## Output format

Return ONLY the recommendations in this exact format (no preamble, no summary):

<number>. <repo-name>
   Watch: <watching type>
   Why:   <One concise sentence connecting the repo to specific user interests>

Use just the repo name (without the org prefix).
SYSTEM_EOF

if [ "$WATCHED_COUNT" -gt 0 ]; then
  WATCHED_LIST=$(echo "$WATCHED" | jq -r '
    .[] | "- \(.name) (\(.language)): \(.description) [topics: \(.topics)]"
  ')
  read -r -d '' USER_PROMPT <<USER_EOF || true
Recommend ${COUNT} repos from the "${ORG}" organization for me to watch.

## My currently watched repos:
${WATCHED_LIST}

## Candidate repos in ${ORG}:
${CANDIDATE_LIST}
USER_EOF
else
  read -r -d '' USER_PROMPT <<USER_EOF || true
Recommend the ${COUNT} most interesting and broadly useful repos from the "${ORG}" organization for me to watch. I'm not currently watching any repos, so base your picks on repo quality, popularity, and coverage of the org's key projects.

## Candidate repos in ${ORG}:
${CANDIDATE_LIST}
USER_EOF
fi

# ── Call GitHub Models (streamed) ────────────────────────────────────

BODY=$(jq -n --arg model "$MODEL" --arg system "$SYSTEM_PROMPT" --arg user "$USER_PROMPT" '{
  model:       $model,
  messages:    [{role: "system", content: $system}, {role: "user", content: $user}],
  temperature: 0.7,
  stream:      true
}')

echo "" >&2

set +e
curl -sS -N \
  "https://models.github.ai/inference/chat/completions" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Content-Type: application/json" \
  -d "$BODY" 2>"$TMPDIR/curl-err.txt" | {
  ERROR=""
  while IFS= read -r line; do
    case "$line" in
      "data: [DONE]") ;;
      "data: "*)
        printf '%s' "${line#data: }" | jq -rj '.choices[0].delta.content // empty' ;;
      "{"*)
        ERROR="$line"
        break ;;
    esac
  done
  echo ""
  if [ -n "$ERROR" ]; then
    echo "$ERROR" | jq -r '"Error: " + (.error.message // .message // "unknown error")' >&2 2>/dev/null \
      || echo "Error: $ERROR" >&2
    exit 1
  fi
} || exit 1
set -e
